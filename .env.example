TELEGRAM_BOT_TOKEN=
SWIGGY_BOT_HOME=var/telegram-bot/state
SWIGGY_BOT_SWIGGY_COMMAND=swiggy

# Optional OAuth client overrides.
SWIGGY_OAUTH_CLIENT_ID=
SWIGGY_OAUTH_CLIENT_SECRET=

# Optional geocoder overrides for typed/manual addresses.
SWIGGY_GEOCODER_URL=https://nominatim.openstreetmap.org/search
SWIGGY_GEOCODER_USER_AGENT=swiggy-cli/local

# Disable automatic browser opening in CI/headless shells.
SWIGGY_AUTH_NO_BROWSER=0
